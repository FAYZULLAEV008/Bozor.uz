// BOZOR.UZ Prisma Schema
// Database schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  APPROVED
  PENDING
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CLICK
  PAYME
  UZUM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String         @unique
  passwordHash  String
  role          Role           @default(CUSTOMER)
  status        UserStatus     @default(ACTIVE)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seller        Seller?
  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  favorites     Favorite[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

model Seller {
  id          String       @id @default(uuid())
  userId      String       @unique
  storeName   String
  description String?
  logo        String?
  phone       String
  address     String?
  rating      Float        @default(5.0)
  totalSales  Int          @default(0)
  status      SellerStatus @default(APPROVED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]

  @@map("sellers")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  image     String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  sellerId       String
  categoryId     String
  name           String
  slug           String
  description    String
  price          Int
  oldPrice       Int?
  discount       Int?
  stock          Int           @default(0)
  sku            String        @unique
  brand          String?
  rating         Float         @default(5.0)
  reviewCount    Int           @default(0)
  isFlashSale    Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  specifications Json?
  images         String[]
  status         ProductStatus @default(APPROVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seller         Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  favorites      Favorite[]
  reviews        Review[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  subtotal        Int
  deliveryFee     Int           @default(0)
  total           Int
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress Json
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int
  image     String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  title       String
  fullName    String
  phone       String
  region      String
  city        String
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
